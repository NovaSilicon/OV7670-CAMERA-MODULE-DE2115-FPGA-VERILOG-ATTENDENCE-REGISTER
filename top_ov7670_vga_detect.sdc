# DE2-115 and OV7670 clock constraints for Quartus Prime 18.1.
# CLOCK_50 is the DE2-115 50 MHz board oscillator.
create_clock -name CLOCK_50 -period 20.000 [get_ports {CLOCK_50}]

# The top-level divides CLOCK_50 by two for the 25 MHz VGA pixel clock.
create_generated_clock -name VGA_CLK -source [get_ports {CLOCK_50}] \
    -divide_by 2 [get_registers {vga_clk_r}]

# The camera XCLK output is generated by a divide-by-two register in
# ov7670_controller. This output clock is related to CLOCK_50.
create_generated_clock -name CAM_XCLK -source [get_ports {CLOCK_50}] \
    -divide_by 2 [get_registers {ov7670_controller:u_cam_ctrl|sys_clk}]

# ov7670_registers.v writes CLKRC=0x00 (Fin/(1+1)), while XCLK is 25 MHz,
# and COM14=0x00 disables PCLK scaling. Thus the configured camera PCLK is
# nominally 12.5 MHz (80 ns period). Confirm on the physical module if its
# register table or clock jumpers are changed.
create_clock -name CAM_PCLK -period 80.000 [get_ports {GPIO[4]}]

# Camera PCLK is an external clock unrelated in phase to the board oscillator.
# Camera capture and VGA use independent ports of the dual-clock framebuffer.
set_clock_groups -asynchronous \
    -group [get_clocks {CAM_PCLK}] \
    -group [get_clocks {CLOCK_50 VGA_CLK CAM_XCLK}]

derive_clock_uncertainty
